# LLM provider: xai | mock
# With AAE_DYNAMIC_PLANNING_ENABLED=false (default), CLI/API always use the
# offline mock planner for the two deterministic goal contracts.
# With the flag enabled, LLM_PROVIDER selects the planner backend (mock canned
# plans by default; xai for a live provider — requires XAI_API_KEY).
LLM_PROVIDER=mock

# Optional planning for a trusted intent catalog (default: off).
# When enabled, three bounded collection grammars are planned deterministically
# and do not call the provider. Other catalog intents use LLM_PROVIDER.
# Automatic replanning stays off; AAE_REPLANNING_ENABLED does not turn it on.
AAE_DYNAMIC_PLANNING_ENABLED=false
# Optional bounded replanning of remaining work (default: off; independent of
# dynamic planning). The executor does not replan automatically. Library calls
# fail closed unless a trusted enablement context is built from these settings.
# The round cap is stored on each task at creation and is not raised later.
# Never expands the original authorization scope.
AAE_REPLANNING_ENABLED=false
# AAE_MAX_REPLAN_ROUNDS=2
# Provider reliability bounds (used when dynamic planning is enabled)
# LLM_REQUEST_TIMEOUT_SECONDS=30
# LLM_MAX_TOKENS=4096
# LLM_MAX_RESPONSE_BYTES=65536
# LLM_MAX_PROVIDER_RETRIES=1

# xAI / Grok (leave empty for local mock mode)
XAI_API_KEY=
XAI_MODEL=grok-2-latest
XAI_BASE_URL=https://api.x.ai/v1

# Application mode:
#   local  - persistent SQLite + workspace shared with the CLI, localhost only
#   public - per-browser-session sandboxes in ephemeral storage (internet demo)
APP_MODE=local
APP_HOST=127.0.0.1
APP_PORT=8000
# PORT (set by hosting providers such as Render) overrides APP_PORT.
LOG_LEVEL=info

# Extra accepted Host header values, comma-separated. Required in public mode
# unless Render sets RENDER_EXTERNAL_HOSTNAME.
ALLOWED_HOSTS=
# Use the last X-Forwarded-For hop as the client address (only behind a proxy).
TRUST_PROXY_HEADERS=false
# Dashboard control that injects one simulated 503 into create_ticket.
ALLOW_FAILURE_INJECTION=true

# Public demo mode only
PUBLIC_DATA_ROOT=
PUBLIC_ACCESS_CODE=
PUBLIC_MAX_SESSIONS=200
PUBLIC_SESSION_TTL_SECONDS=3600
PUBLIC_MAX_TASKS_PER_SESSION=20

# Persistence (SQLite) — runtime state/events + mock company world tables.
# Must be outside WORKSPACE_PATH (startup fails otherwise).
DATABASE_PATH=data/runtime.db

# Sandboxed filesystem for FileTool
WORKSPACE_PATH=workspace

# Bounded recovery retries after the first failed attempt of a step
MAX_RECOVERY_ATTEMPTS=2
